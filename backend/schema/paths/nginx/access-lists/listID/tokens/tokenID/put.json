{
	"operationId": "updateAccessListToken",
	"summary": "Update a header token",
	"tags": ["access-lists"],
	"security": [
		{
			"bearerAuth": ["access_lists.manage"]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "listID",
			"description": "Access List ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		},
		{
			"in": "path",
			"name": "tokenID",
			"description": "Token ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 4
		}
	],
	"requestBody": {
		"description": "Token Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"name": {
							"$ref": "../../../../../../components/access-list-token-object.json#/properties/name"
						},
						"forward": {
							"$ref": "../../../../../../components/access-list-token-object.json#/properties/forward"
						}
					}
				},
				"example": {
					"name": "Overseerr",
					"forward": false
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 4,
								"created_on": "2026-10-04T08:00:00.000Z",
								"modified_on": "2026-10-04T08:00:00.000Z",
								"access_list_id": 2,
								"name": "Overseerr",
								"header_name": "X-Api-Key",
								"forward": true,
								"last_used_on": null,
								"meta": {}
							}
						}
					},
					"schema": {
						"$ref": "../../../../../../components/access-list-token-object.json"
					}
				}
			}
		}
	}
}
