{
	"type": "object",
	"description": "Access List object",
	"required": ["id", "created_on", "modified_on", "owner_user_id", "name", "meta", "satisfy_any", "pass_auth", "key_auth", "key_session_hours", "proxy_host_count"],
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"example": "My Access List"
		},
		"meta": {
			"type": "object",
			"example": {}
		},
		"satisfy_any": {
			"type": "boolean",
			"example": true
		},
		"pass_auth": {
			"type": "boolean",
			"example": false
		},
		"key_auth": {
			"type": "boolean",
			"description": "Accept security keys, through a sign-in page on the protected site",
			"example": true
		},
		"key_session_hours": {
			"type": "integer",
			"description": "How long a sign-in lasts, in hours",
			"minimum": 1,
			"maximum": 8760,
			"example": 168
		},
		"proxy_host_count": {
			"type": "integer",
			"minimum": 0,
			"example": 3
		},
		"keys": {
			"type": "array",
			"description": "Security keys, when expanded",
			"items": {
				"$ref": "./access-list-key-object.json"
			},
			"example": [
				{
					"id": 3,
					"created_on": "2026-10-04T08:00:00.000Z",
					"modified_on": "2026-10-04T08:00:00.000Z",
					"access_list_id": 2,
					"name": "Backup YubiKey",
					"rp_id": "example.com",
					"transports": ["nfc", "usb"],
					"last_used_on": null,
					"meta": {}
				}
			]
		},
		"tokens": {
			"type": "array",
			"description": "Header tokens, when expanded",
			"items": {
				"$ref": "./access-list-token-object.json"
			},
			"example": [
				{
					"id": 4,
					"created_on": "2026-10-04T08:00:00.000Z",
					"modified_on": "2026-10-04T08:00:00.000Z",
					"access_list_id": 2,
					"name": "Overseerr",
					"header_name": "X-Api-Key",
					"forward": true,
					"last_used_on": null,
					"meta": {}
				}
			]
		}
	}
}
