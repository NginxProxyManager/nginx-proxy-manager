{
	"operationId": "providerCallback",
	"summary": "OAuth redirect target",
	"description": "Where the identity provider sends the browser back to. Redirects to the login screen with a single use code, or an error message.",
	"tags": ["auth"],
	"parameters": [
		{
			"in": "path",
			"name": "providerID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"description": "Authentication Provider ID",
			"example": 2
		}
	],
	"responses": {
		"302": {
			"description": "Redirect to the login screen"
		}
	}
}
