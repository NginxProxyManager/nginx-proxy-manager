{
	"operationId": "getApiTokenOptions",
	"summary": "Get allowed scopes and step-up requirements",
	"tags": [
		"api-tokens"
	],
	"security": [
		{
			"bearerAuth": []
		}
	],
	"responses": {
		"200": {
			"description": "Successful operation",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../components/api-token-options.json"
					},
					"example": {
						"scopes": [
							"proxy_hosts:read"
						],
						"visibility": "user",
						"requires_2fa": false,
						"max_expiry_days": 365,
						"default_expiry_days": 30
					}
				}
			}
		},
		"401": {
			"description": "Authentication required"
		},
		"403": {
			"description": "Session, owner permissions or step-up verification required"
		}
	}
}
