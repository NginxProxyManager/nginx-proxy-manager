							"minLength": 1
						},
						"to": {
							"type": "string",
							"minLength": 1
						}
					}
				}
			},
			"proxy_ssl_server_name": {
				"type": "boolean"
			},
			"proxy_ssl_name": {
				"type": "string",
				"minLength": 1
			},
			"proxy_ssl_verify": {
				"type": "boolean"
			},
			"proxy_ssl_verify_depth": {
				"type": "integer",
				"minimum": 0,
				"maximum": 2147483647
			},
			"proxy_ssl_session_reuse": {
				"type": "boolean"
			},
			"proxy_ssl_protocols": {
				"type": "array",
				"minItems": 1,
				"uniqueItems": true,
				"items": {
					"type": "string",
					"enum": [
						"TLSv1",
						"TLSv1.1",
						"TLSv1.2",
						"TLSv1.3"
					]
				}
			},
			"proxy_ssl_ciphers": {
				"type": "string",
				"minLength": 1
			},
			"request_headers": {
				"type": "array",
				"items": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"name"
					],
					"properties": {
						"name": {
							"type": "string",
							"pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
						},
						"operation": {
							"type": "string",
							"enum": [
								"set",
								"remove"
							],
							"default": "set"
						},
						"value": {
							"type": "string",
							"maxLength": 8192
						},
						"value_mode": {
							"type": "string",
							"enum": [
								"literal",
								"variable"
							],
							"default": "literal"
						}
					}
				},
				"description": "Request header rules map to proxy_set_header. Add is intentionally unsupported because proxy_set_header cannot safely append an arbitrary incoming header value."
			},
			"response_headers": {
				"type": "array",
				"items": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"name"
					],
					"properties": {
						"name": {
							"type": "string",
							"pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
						},
						"operation": {
							"type": "string",
							"enum": [
								"set",
								"add",
								"remove"
							],
							"default": "set"
						},
						"value": {
							"type": "string",
							"maxLength": 8192
						},
						"value_mode": {
							"type": "string",
							"enum": [
								"literal",
								"variable"
							],
							"default": "literal"
						}
					}
				},
				"description": "Response set maps to proxy_hide_header plus add_header; add maps to add_header; remove maps to proxy_hide_header."
			},
			"hide_response_headers": {
				"type": "array",
				"uniqueItems": true,
				"items": {
					"type": "string"
				}
			},
			"proxy_pass_headers": {
				"type": "array",
				"uniqueItems": true,
				"items": {
					"type": "string"
				}
			},
			"proxy_ignore_headers": {
				"type": "array",
				"uniqueItems": true,
				"items": {
					"type": "string",
					"enum": [
						"X-Accel-Expires",
						"X-Accel-Redirect",
						"X-Accel-Limit-Rate",
						"X-Accel-Buffering",
						"X-Accel-Charset",
						"Expires",
						"Cache-Control",
						"Set-Cookie",
						"Vary"
					]
				}
			}
		}
	}
}
