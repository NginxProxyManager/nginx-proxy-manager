{
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"profile_version",
		"runtime_family",
		"nginx_version",
		"architectures",
		"ipv6",
		"modules",
		"image",
		"source_sha256",
		"notes",
		"profile_hash"
	],
	"properties": {
		"source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
		"schema_version": {
			"type": "integer",
			"const": 1
		},
		"profile_version": {
			"type": "string"
		},
		"runtime_family": {
			"type": "string"
		},
		"nginx_version": {
			"type": "string"
		},
		"architectures": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "string"
			}
		},
		"ipv6": {
			"type": "boolean"
		},
		"modules": {
			"type": "array",
			"uniqueItems": true,
			"items": {
				"type": "string"
			}
		},
		"image": {
			"type": "string"
		},
		"image_digest": {
			"type": "string",
			"pattern": "^sha256:[a-f0-9]{64}$"
		},
		"notes": {
			"type": "string"
		},
		"validated_on": {
			"type": "string",
			"format": "date"
		},
		"profile_hash": {
			"type": "string",
			"pattern": "^sha256:[a-f0-9]{64}$"
		}
	}
}
