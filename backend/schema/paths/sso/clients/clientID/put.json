{
  "operationId": "updateSingleSignOnClient",
  "summary": "Update SSO Client configuration",
  "tags": ["sso-clients"],
  "security": [
    {
      "bearerAuth": ["admin"]
    }
  ],
  "parameters": [
		{
			"in": "path",
			"name": "clientID",
			"description": "The ID of the Client",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
  "requestBody": {
    "description": "SSO Client Payload",
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {
              "$ref": "../../../../components/sso-client-object.json#/properties/name"
            },
            "client_type": {
              "$ref": "../../../../components/sso-client-object.json#/properties/client_type"
            },
            "enabled": {
              "$ref": "../../../../components/sso-client-object.json#/properties/enabled"
            },
            "configuration": {
        			"oneOf": [
         				{
    							"type": "object",
               		"additionalProperties": false,
                  "properties": {
                    "meta": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  }
    						},
        				{
        					"$ref": "../../../../components/sso-client-openid.json"
        				},
        				{
        					"$ref": "../../../../components/sso-client-saml.json"
        				}
        			]
        		},
            "meta": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "example": {
                "": {
                  "name": "Authentik",
                  "client_type": "OAuth2/OpenID",
                  "enabled": true,
                  "configuration": {
                    "client_id": "123",
                    "client_secret":"",
                    "configuration_url": "",
                    "redirect_url":"http://localhost:3081/api/sso/oauth2/1/callback"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "200 response",
      "content": {
        "application/json": {
          "examples": {
            "default": {
              "id": 1,
              "created_on": "2026-10-25 13:51:09",
              "modified_on": "2026-10-25 13:51:09",
              "owner_user_id": 1,
              "client_type": "OAuth2/OpenID",
              "name":"Authentik",
              "enabled": true,
              "meta": {},
              "configuration": {
                "client_id": "123",
                "client_secret":"",
                "configuration_url": "",
                "redirect_url":"http://localhost:3081/api/sso/oauth2/1/callback"
              }
            }
          },
          "schema": {
            "$ref": "../../../../components/sso-client-object.json"
          }
        }
      }
    }
  }
}
