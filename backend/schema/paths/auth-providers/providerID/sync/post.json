{
	"operationId": "runAuthProviderSync",
	"summary": "Run a directory sync now",
	"description": "Walks the provider's directory immediately instead of waiting for the schedule. LDAP only.",
	"tags": ["auth-providers"],
	"security": [
		{
			"bearerAuth": ["admin"]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "providerID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"description": "Authentication Provider ID",
			"example": 1
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/auth-sync-result.json"
					}
				}
			}
		}
	}
}
