#!/usr/bin/env node

import * as process from "node:process"; // Use the node: protocol for built-ins
import internalNginx from "../internal/nginx.js";
import { global as logger } from "../logger.js";
import deadHostModel from "../models/dead_host.js";
import proxyHostModel from "../models/proxy_host.js";
import redirectionHostModel from "../models/redirection_host.js";
import streamModel from "../models/stream.js";

const args = process.argv.slice(2);
const UNATTENDED = args.includes("-y") || args.includes("--yes");
const DRY_RUN = args.includes("--dry-run");
const RESTORE_ASIDE = args.includes("--restore-aside");

if (args.includes("--help") || args.includes("-h")) {
	console.log("\nThis will iterate over all Hosts and regnerate their Nginx configs.\n")
	console.log("Usage: ./regenerate-config [-h|--help] [-y|--yes] [--dry-run] [--restore-aside]\n");
	console.log("This script runs outside the backend and doesn't share its lock: run it while nobody saves hosts,");
	console.log("or use Settings > Nginx Configuration in the UI (POST /api/nginx/regenerate) instead.\n");
	console.log("  --restore-aside  also put back config files that an interrupted config test left as");
	console.log("                   *.conf.npm-aside. Only while the backend is stopped: it moves files aside");
	console.log("                   for a moment while it tests a config.\n");
	process.exit(0);
}

// ask for the user to confirm the action if not in unattended mode
if (!UNATTENDED && !DRY_RUN) {
	const readline = await import("node:readline");
	const rl = readline.createInterface({
		input: process.stdin,
		output: process.stdout,
	});

	const question = (query) =>
		new Promise((resolve) => rl.question(query, resolve));

	const answer = await question(
		"This will iterate over all Hosts and regnerate their Nginx configs.\n\nAre you sure you want to proceed? (y/N) ",
	);
	rl.close();

	if (answer.toLowerCase() !== "y") {
		console.log("Aborting.");
		process.exit(0);
	}
}

const logIt = (msg, type = "info") => logger[type](
	`${DRY_RUN ? '[DRY RUN] ' : ''}${msg}`,
);

// Let's do it.

if (DRY_RUN) {
	const models = [
		[proxyHostModel, "Proxy Host"],
		[redirectionHostModel, "Redirection Host"],
		[deadHostModel, "404 Host"],
		[streamModel, "Stream"],
	];
	for (const [model, type] of models) {
		const rows = await model.query().where("is_deleted", 0).andWhere("enabled", 1).orderBy("id");
		logIt(`[${type}] Found ${rows.length} rows to process...`);
		for (const row of rows) {
			logIt(`[${type}] Skipping generation of config #${row.id}: ${row.domain_names ? row.domain_names.join(", ") : `port ${row.incoming_port}`}`);
		}
	}
	logIt("Completed", "success");
	process.exit(0);
}

// The same code path as Settings > Nginx Configuration in the UI (POST /api/nginx/regenerate):
// every host is configured as on save, hosts nginx rejects are taken offline, nginx reloads once.
try {
	// No --restore-aside: the backend (a different process, it doesn't share this process' lock) may be testing a
	// config right now with another host's file moved aside, putting that file back would break its test.
	const summary = await internalNginx.regenerateAll({ restoreAside: RESTORE_ASIDE });
	for (const item of summary.offline) {
		logIt(`[${item.host_type}] #${item.id} ${item.name} is offline: ${item.error}`, "warn");
	}
	for (const item of summary.failed) {
		logIt(`[${item.host_type}] #${item.id} ${item.name} could not be regenerated, kept its previous config: ${item.error}`, "error");
	}
	for (const item of summary.warnings) {
		logIt(`[${item.host_type}] #${item.id} ${item.name}: ${item.message.replace(/\n/g, "; ")}`, "warn");
	}
	logIt(
		`Completed: checked ${summary.checked} hosts, regenerated ${summary.regenerated}, offline ${summary.offline.length}, failed ${summary.failed.length}`,
		"success",
	);
	process.exit(0);
} catch (err) {
	logIt(`Regenerating failed: ${err.message}`, "error");
	if (err.regenerateSummary) {
		const summary = err.regenerateSummary;
		logIt(
			`Until then: checked ${summary.checked} hosts, regenerated ${summary.regenerated}, offline ${summary.offline.length}, failed ${summary.failed.length}`,
			"warn",
		);
	}
	process.exit(1);
}
