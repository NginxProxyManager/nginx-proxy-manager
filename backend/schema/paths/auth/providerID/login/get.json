{
	"operationId": "startProviderLogin",
	"summary": "Begin a SAML or OAuth login",
	"description": "Redirects the browser to the identity provider. Not intended to be called with fetch.",
	"tags": ["auth"],
	"parameters": [
		{
			"in": "path",
			"name": "providerID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"description": "Authentication Provider ID",
			"example": 2
		}
	],
	"responses": {
		"302": {
			"description": "Redirect to the identity provider"
		}
	}
}
