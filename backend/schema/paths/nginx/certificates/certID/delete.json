{
	"operationId": "deleteCertificate",
	"summary": "Delete a Certificate",
	"tags": ["certificates"],
	"security": [
		{
			"bearerAuth": ["certificates.manage"]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "certID",
			"description": "Certificate ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": true
						}
					},
					"schema": {
						"type": "boolean"
					}
				}
			}
		},
		"400": {
			"description": "400 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Certificate is in use by 1 proxy host. Remove it from them before deleting it."
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/error.json"
					}
				}
			}
		}
	}
}
