{
	"operationId": "testProxyHostConfig",
	"summary": "Test the configuration of a Proxy Host without saving it",
	"description": "Validates the payload like a save would (schema, duplicate custom location paths, forbidden file directives, domain names in use: 400) and lets nginx check the generated configuration without activating it: nothing is written to the database, nginx is not reloaded and other hosts are not changed. A configuration nginx rejects is returned as ok:false with the error a save would fail with. Also checks that the upstream targets are reachable. Needs the create permission, or the update permission when id is given. Rate limited to 30 tests per minute per user.",
	"tags": [
		"proxy-hosts"
	],
	"security": [
		{
			"bearerAuth": [
				"proxy_hosts.manage"
			]
		}
	],
	"requestBody": {
		"description": "Proxy Host payload, the same as for creating one, plus id when testing an edit",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"domain_names",
						"forward_scheme",
						"forward_host",
						"forward_port"
					],
					"properties": {
						"id": {
							"type": "integer",
							"minimum": 1,
							"description": "Set when testing changes to an existing proxy host: the payload is merged over the stored one, like an update",
							"example": 12
						},
						"domain_names": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/domain_names"
						},
						"forward_scheme": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/forward_scheme"
						},
						"forward_host": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/forward_host"
						},
						"forward_port": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/forward_port"
						},
						"certificate_id": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/certificate_id"
						},
						"ssl_forced": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/ssl_forced"
						},
						"hsts_enabled": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/hsts_enabled"
						},
						"hsts_subdomains": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/hsts_subdomains"
						},
						"trust_forwarded_proto": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/trust_forwarded_proto"
						},
						"http2_support": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/http2_support"
						},
						"block_exploits": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/block_exploits"
						},
						"caching_enabled": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/caching_enabled"
						},
						"allow_websocket_upgrade": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/allow_websocket_upgrade"
						},
						"access_list_id": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/access_list_id"
						},
						"advanced_config": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/advanced_config"
						},
						"enabled": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/enabled"
						},
						"meta": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/meta"
						},
						"locations": {
							"$ref": "../../../../components/proxy-host-object.json#/properties/locations"
						}
					}
				},
				"example": {
					"domain_names": [
						"test.example.com"
					],
					"forward_scheme": "http",
					"forward_host": "127.0.0.1",
					"forward_port": 8080
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"ok": true,
								"nginx_online": true,
								"nginx_err": null,
								"nginx_details": null,
								"nginx_locations": [
									{
										"index": 0,
										"path": "/api",
										"status": "ok",
										"mode": "dynamic",
										"message": null
									}
								],
								"upstreams": [
									{
										"host": "app",
										"port": 8080,
										"scheme": "http",
										"ok": true,
										"code": "ok",
										"message": "app:8080 is reachable (1.2 ms).",
										"addresses": [
											"172.18.0.5"
										],
										"resolver_ok": true,
										"system_ok": true,
										"ms": 1.2,
										"location_index": null,
										"path": null
									}
								],
								"warnings": []
							}
						},
						"rejected": {
							"value": {
								"ok": false,
								"nginx_online": false,
								"nginx_err": "Advanced configuration: unknown directive \"proxy_passs\" (line 3).",
								"nginx_details": {
									"kind": "nginx_config",
									"scope": "host",
									"host_type": "proxy_host",
									"host_id": 12,
									"file": "/data/nginx/proxy_host/12.conf",
									"line": 31,
									"location_index": null,
									"location_path": null,
									"nginx_output": "nginx: [emerg] unknown directive \"proxy_passs\" in /data/nginx/proxy_host/12.conf:31",
									"hint": "Check the spelling of the directive. If it comes from an nginx module, that module may not be available."
								},
								"nginx_locations": [],
								"upstreams": [],
								"warnings": []
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/host-test-result.json"
					}
				}
			}
		},
		"400": {
			"description": "400 response, the payload is invalid (eg. a domain name is already in use)",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "test.example.com is already in use"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/error.json"
					}
				}
			}
		},
		"429": {
			"description": "Too many tests",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 429,
									"message": "Too many configuration tests. Try again in 20 seconds."
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/error.json"
					}
				}
			}
		}
	}
}
