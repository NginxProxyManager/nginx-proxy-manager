{
  "operationId": "enableSingleSignOnClient",
  "summary": "Enable SSO Client configuration",
  "tags": ["sso-clients"],
  "security": [
    {
      "bearerAuth": ["admin"]
    }
  ],
  "parameters": [
		{
			"in": "path",
			"name": "clientID",
			"description": "The ID of the Client",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 2
		}
	],
  "responses": {
    "200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": true
						}
					},
					"schema": {
						"type": "boolean"
					}
				}
			}
		}
  }
}
