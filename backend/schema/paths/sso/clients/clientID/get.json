{
  "operationId": "getSingleSignOnClient",
  "summary": "Get an Single Sign On Client",
  "tags": ["sso-clients"],
  "security": [
    {
      "bearerAuth": ["admin"]
    }
  ],
  "parameters": [
    {
      "in": "path",
      "name": "clientID",
      "schema": {
        "type": "string",
        "minLength": 1
      },
      "required": true,
      "description": "SSO Client type",
      "example": "OpenID"
    }
  ],
  "responses": {
    "200": {
      "description": "200 response",
      "content": {
        "application/json": {
          "examples": {
            "default": {
              "id": 1,
              "created_on": "2026-10-25 13:51:09",
              "modified_on": "2026-10-25 13:51:09",
              "owner_user_id": 1,
              "client_type": "OpenID",
              "name":"Authentik",
              "enabled": true,
              "meta": {},
              "configuration": {
                "client_id": "123",
                "client_secret":"",
                "configuration_url": "",
                "redirect_url":"http://localhost:3081/api/sso/oauth2/1/callback"
              }
            }
          },
          "schema": {
            "$ref": "../../../../components/sso-client-object.json"
          }
        }
      }
    }
  }
}
