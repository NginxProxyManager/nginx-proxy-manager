{
  "operationId": "createSingleSignOnClient",
  "summary": "Create a Single Sign On Client",
  "tags": ["sso-clients"],
  "security": [
    {
      "bearerAuth": ["admin"]
    }
  ],
  "requestBody": {
    "description": "Single Sign On Client Payload",
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
					"additionalProperties": false,
					"required": [
						"name",
						"client_type",
						"enabled"
					],
          "properties": {
            "name": {
              "$ref": "../../../components/sso-client-object.json#/properties/name"
            },
            "client_type": {
              "$ref": "../../../components/sso-client-object.json#/properties/client_type"
            },
            "enabled": {
              "$ref": "../../../components/sso-client-object.json#/properties/enabled"
            },
            "allow_internal": {
          		"$ref": "../../../components/sso-client-object.json#/properties/allow_internal"
        		},
        		"button_text": {
          		"$ref": "../../../components/sso-client-object.json#/properties/button_text"
        		},
        		"require_verified_email": {
        		  "$ref": "../../../components/sso-client-object.json#/properties/require_verified_email"
        		},
        		"allow_internal_if_admin": {
          		"$ref": "../../../components/sso-client-object.json#/properties/allow_internal_if_admin"
        		},
        		"require_group": {
        		  "$ref": "../../../components/sso-client-object.json#/properties/require_group"
        		},
        		"require_group_name": {
        		  "$ref": "../../../components/sso-client-object.json#/properties/require_group_name"
        		},
        		"provision_users": {
        		  "$ref": "../../../components/sso-client-object.json#/properties/provision_users"
        		},
        		"require_provision_group": {
        		  "$ref": "../../../components/sso-client-object.json#/properties/require_provision_group"
        		},
        		"require_provision_group_name": {
        		  "$ref": "../../../components/sso-client-object.json#/properties/require_provision_group_name"
        		},
        		"provision_role_map": {
        		  "$ref": "../../../components/sso-client-object.json#/properties/provision_role_map"
            },
            "configuration": {
        			"oneOf": [
         				{
         					"$ref": "../../../components/sso-client-auth0.json"
         				},
                {
         					"$ref": "../../../components/sso-client-github.json"
         				},
                {
         					"$ref": "../../../components/sso-client-openid.json"
         				},
         				{
         					"$ref": "../../../components/sso-client-saml.json"
         				}
        			]
        		},
            "meta": {
              "type": "object",
              "properties": {
                "role_map": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "role": "string",
                    "group": "string"
                  }
                }
              },
              "example": {
                "role_map": {
                  "role": "user",
                  "group": "NginxProxyManager-access"
                }
              }
            }
          }
        },
        "example": {
          "value": "congratulations",
          "meta": {}
        }
      }
    }
  },
  "responses": {
    "200": {
      "description": "200 response",
      "content": {
        "application/json": {
          "examples": {},
          "schema": {
            "$ref": "../../../components/sso-client-object.json"
          }
        }
      }
    }
  }
}
